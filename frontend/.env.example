# Bible QA Frontend Environment Variables Example
# Copy this file to .env.local and fill in the values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Profile Configuration (Names and IDs)
# Replace with actual names in .env.local (e.g., Mom, Dad, Name1, Name2)
NEXT_PUBLIC_PROFILE_1_ID=11111111-1111-1111-1111-111111111111
NEXT_PUBLIC_PROFILE_1_NAME=Profile 1

NEXT_PUBLIC_PROFILE_2_ID=22222222-2222-2222-2222-222222222222
NEXT_PUBLIC_PROFILE_2_NAME=Profile 2

NEXT_PUBLIC_PROFILE_3_ID=33333333-3333-3333-3333-333333333333
NEXT_PUBLIC_PROFILE_3_NAME=Profile 3

NEXT_PUBLIC_PROFILE_4_ID=44444444-4444-4444-4444-444444444444
NEXT_PUBLIC_PROFILE_4_NAME=Profile 4
